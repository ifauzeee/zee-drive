{
  "name": "zee-drive",
  "version": "0.1.0",
  "description": "Lightweight Google Drive file explorer and media streaming server on Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "dev:web": "vite build --watch",
    "build:web": "vite build",
    "build": "npm run build:web",
    "deploy": "npm run build:web && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply zee-index-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zee-index-db --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "client-zip": "^2.5.1",
    "hono": "^4.13.8",
    "plyr": "^3.8.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  }
}
